<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Yalnızca src altındaki kütüphaneler paketlenir; sürüm hepsinde aynıdır ve birlikte ilerler. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Authors>Haldus</Authors>
    <PackageProjectUrl>https://github.com/haldusdev/haldus</PackageProjectUrl>
    <RepositoryUrl>https://github.com/haldusdev/haldus</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>haldus;aspnetcore;minimal-api;efcore;source-generator;crud</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Eksik belge yorumu hata sayılmaz (yorumu olmayan üye, yorumu olmayan parametre); yazılmış olanlar IntelliSense'e
      taşınır. Yanlış yorum (bozuk XML, var olmayan parametre, çözülemeyen cref) hata olmaya devam eder.
    -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- Semboller paketin içindedir: yerel bir kaynaktan tüketen proje de kaynağa adım atabilir. -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
