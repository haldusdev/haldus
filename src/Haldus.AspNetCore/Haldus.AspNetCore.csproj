<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Archetype ve trait'lerle tekrarlayan backend kodunu derleme zamanında üreten framework. AddHaldus, Map* giriş noktaları ve kaynak üreticisi (generator) bu pakettedir.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Haldus.Abstractions\Haldus.Abstractions.csproj" />
    <ProjectReference Include="..\Haldus.EntityFrameworkCore\Haldus.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <!--
    Generator ayrı bir paket değildir, bu paketin içinde gelir: tüketen proje tek bir paket ekler ve üretilen kod ile
    çağırdığı çalışma zamanı her zaman aynı sürümdedir. Başvuru yalnızca derleme sırası içindir (bu proje generator'ı
    kendisi çalıştırmaz, pakete de bağımlılık olarak yazılmaz); derlenen dosya analyzer klasörüne konur.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Haldus.Generators\Haldus.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Haldus.Generators\bin\$(Configuration)\netstandard2.0\Haldus.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- Kılavuz paketle birlikte gelir: tüketen projedeki bir ajan, kurulu sürümün kılavuzunu ağa çıkmadan okur. -->
  <ItemGroup>
    <None Include="..\..\docs\guide.md" Pack="true" PackagePath="docs" Visible="false" />
  </ItemGroup>

</Project>
